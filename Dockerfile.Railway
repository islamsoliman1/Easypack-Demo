FROM node:22-bookworm-slim AS web
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY frontend/index.html frontend/tsconfig.json frontend/vite.config.ts ./
COPY frontend/src/ ./src/
COPY frontend/public/ ./public/
RUN npm run build

FROM maven:3.9.11-eclipse-temurin-21 AS api
WORKDIR /build/backend
COPY backendjava/pom.xml ./
COPY backendjava/src/main/java/ ./src/main/java/
COPY backendjava/src/main/resources/ ./src/main/resources/
COPY --from=web /build/frontend/dist/ ./src/main/resources/static/
RUN mvn -B -ntp -Dmaven.test.skip=true package

FROM api AS verify
COPY backendjava/src/test/ ./src/test/
RUN mvn -B -ntp test

FROM eclipse-temurin:21-jre-jammy AS runtime
WORKDIR /app
# 256 MiB heap plus bounded VM areas leaves native/thread headroom in 512 MiB.
ENV JAVA_TOOL_OPTIONS="-Xms64m -Xmx256m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=32m -XX:MaxDirectMemorySize=32m -Xss512k -XX:+ExitOnOutOfMemoryError" \
    SPRING_PROFILES_ACTIVE=railway,demo
COPY --from=api --chown=10001:10001 /build/backend/target/easyback-api-0.1.0.jar /app/app.jar
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
